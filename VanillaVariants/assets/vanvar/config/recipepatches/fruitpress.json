[
    // replace planks with oak plank
    {
        "type": "Replace",
        "conditions": [{ "when": "VanillaVariants_FruitPress_Enabled", "isValue": "true" }],
        "outputCode": "fruitpress-ns",
        "ingredients": [
            { "ingredientCode": "plank-*", "AllowedVariants": ["oak"] },
            { "ingredientCode": "rod-*", "Name": "metal", "AllowedVariants": ["copper"] }
        ]
    },
    {
        "type": "Replace",
        "conditions": [{ "when": "VanillaVariants_FruitPress_Enabled", "isValue": "true" }],
        "dependsOn": [{ "modid": "wildcrafttree" }],
        "outputCode": "fruitpress-ns",
        "ingredients": [
            { "ingredientCode": "wildcrafttree:plank-*", "Code": "plank-*", "AllowedVariants": ["oak"] },
            { "ingredientCode": "rod-*", "Name": "metal", "AllowedVariants": ["copper"] }
        ]
    },

    // from any wood and copper metal
    {
        "type": "Copy",
        "conditions": [{ "when": "VanillaVariants_FruitPress_Enabled", "isValue": "true" }],
        "outputCode": "fruitpress-ns",
        "outputCodeNew": "vanvar:fruitpress-{metal}-{wood}-ns",
        "ingredients": [
            { "ingredientCode": "plank-*", "Name": "wood", "SkipVariants": ["oak"] },
            { "ingredientCode": "rod-*", "Name": "metal", "AllowedVariants": ["copper"] }
        ]
    },
    {
        "type": "Copy",
        "conditions": [{ "when": "VanillaVariants_FruitPress_Enabled", "isValue": "true" }],
        "dependsOn": [{ "modid": "wildcrafttree" }],
        "outputCode": "fruitpress-ns",
        "outputCodeNew": "wildcrafttree:fruitpress-{metal}-{wood}-ns",
        "ingredients": [
            { "ingredientCode": "plank-*", "Name": "wood", "SkipVariants": ["oak"] },
            { "ingredientCode": "rod-*", "Name": "metal", "AllowedVariants": ["copper"] }
        ]
    },

    // from any wood and metal, except copper metal
    {
        "type": "Copy",
        "conditions": [{ "when": "VanillaVariants_FruitPress_Enabled", "isValue": "true" }],
        "outputCode": "fruitpress-ns",
