        "outputCodeNew": "wildcrafttree:fruitpress-{metal}-{wood}-ns",
        "ingredients": [
            { "ingredientCode": "plank-*", "Name": "wood", "Code": "wildcrafttree:plank-*" },
            { "ingredientCode": "rod-*", "Name": "metal", "AllowedVariants": ["tinbronze", "bismuthbronze", "blackbronze", "iron", "meteoriciron", "steel"] }
